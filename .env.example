# ============================================
# CORE CONFIGURATION
# ============================================
RPC_URL=your_rpc_url
RPC_WS_URL=your_ws_url (optional)
CHAIN_ID=137
EXECUTION_PRIVATE_KEY=your_private_key
TREASURY_ADDRESS=your_treasury_address

# ============================================
# ENSO (Primary Execution Engine)
# ============================================
ENSO_API_KEY=your_enso_api_key
ENSO_BASE_URL=https://api.enso.build/api

# ============================================
# DATABASE
# ============================================
DATABASE_URL=your_postgres_database_url

# ============================================
# RISK & THRESHOLDS
# ============================================
DEFAULT_MIN_PROFIT_USD=0.05
DEFAULT_MIN_SPREAD_BPS=2
MAX_POSITION_SIZE_USD=25000
MAX_CONCURRENT_TRADES=3
MAX_SLIPPAGE_BPS=300
MAX_PRICE_IMPACT_BPS=300
MAX_GAS_PRICE_GWEI=300

# ============================================
# STRATEGY TOGGLES
# ============================================
STRATEGY_CLASSIC_ENABLED=true
STRATEGY_LP_ENABLED=false
STRATEGY_VAULT_ENABLED=false
STRATEGY_DEBT_ENABLED=false
STRATEGY_HARVEST_ENABLED=false

# ============================================
# CLASSIC INCENTIVE - OPTIONAL ADDRESSES
# ============================================
# These are optional. The bot will self-discover protocols like QuickSwap.
# Only add specific vaults you want to target.

# Priority 1: Beefy Finance Vaults (Optional)
BEEFY_VAULT_ADDRESS=0x...
BEEFY_WETH_VAULT=0x...

# Priority 2: Convex / Harvest Finance (Optional)
CONVEX_ADDRESS=0x...
HARVEST_VAULT_ADDRESS=0x...

# ============================================
# CLASSIC INCENTIVE - SCANNER CONFIG
# ============================================
CLASSIC_INCENTIVE_MIN_PROFIT_USD=0.05
CLASSIC_INCENTIVE_MAX_PROTOCOLS=20
SUBGRAPH_API_KEY=your_subgraph_api_key

# ============================================
# ALERTS & LOGGING
# ============================================
DISCORD_WEBHOOK_URL=your_discord_webhook (optional)
LOG_LEVEL=info
NODE_ENV=production