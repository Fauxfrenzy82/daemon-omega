# ============================================
# Blockchain / RPC
# ============================================
RPC_URL=
RPC_WS_URL=
CHAIN_ID=137

# ============================================
# Polygon Private Mempool RPC (MEV protection)
# ============================================
PRIVATE_MEMPOOL_RPC=https://private-mempool.polygon.technology

# ============================================
# Wallets
# ============================================
EXECUTION_PRIVATE_KEY=
TREASURY_ADDRESS=

# ============================================
# Enso (primary execution engine)
# ============================================
ENSO_API_KEY=
ENSO_BASE_URL=https://api.enso.build/api

# ============================================
# DEX Aggregators (quote sources)
# ============================================
PARASWAP_API_URL=https://apiv5.paraswap.io
OPENOCEAN_API_URL=https://open-api.openocean.finance/v3/polygon
ZEROEX_API_KEY=

# ============================================
# Database
# ============================================
DATABASE_URL=

# ============================================
# Risk / Thresholds
# ============================================
MIN_PROFIT_USD=0.05
MIN_SPREAD_BPS=2
MAX_POSITION_SIZE_USD=25000
MAX_CONCURRENT_TRADES=3
MAX_SLIPPAGE_BPS=300
MAX_PRICE_IMPACT_BPS=300

# ============================================
# Circuit Breaker
# ============================================
MAX_CONSECUTIVE_LOSSES=999
CIRCUIT_BREAKER_LOOKBACK_MINUTES=5
MAX_GAS_PRICE_GWEI=300
CIRCUIT_BREAKER_COOLDOWN_MS=900000

# ============================================
# Sweep (profit collection)
# ============================================
SWEEP_ENABLED=true
SWEEP_MIN_BALANCE_USD=2
SWEEP_KEEP_GAS_RESERVE_USD=1
SWEEP_TARGET_SYMBOL=USDC
SWEEP_DUST_THRESHOLD_USD=0.01

# ============================================
# Alerts (Discord)
# ============================================
DISCORD_WEBHOOK_URL=

# ============================================
# Scanner
# ============================================
SCAN_INTERVAL_MS=15000
LOG_LEVEL=info
NODE_ENV=production

# ============================================
# MASTER TOGGLE — Set to false to disable ALL strategies
# ============================================
MASTER_STRATEGY_ENABLED=true

# ============================================
# STRATEGY TOGGLES
# ============================================
# Classic Incentive — Aave V3 + QuickSwap V3 incentive programs
STRATEGY_CLASSIC_ENABLED=true

# LP Entry/Exit — DEX round-trip arbitrage
STRATEGY_LP_ENABLED=false

# Vault Arbitrage — StataToken wrapper arbitrage
STRATEGY_VAULT_ENABLED=false

# Debt Position — Aave V3 liquidation arbitrage
STRATEGY_DEBT_ENABLED=false

# Harvest + Spot Sell — claim rewards and sell
STRATEGY_HARVEST_ENABLED=false

# ============================================
# Enso Route
# ============================================
USE_ENSO_ROUTE_PRIMARY=true
ENSO_REQUEST_DELAY_MS=800
PRIMARY_PAIR_IDS=WETH-USDC,WBTC-USDC,WMATIC-USDC,USDCe-USDT,DAI-USDC
SECONDARY_PAIR_IDS=LINK-USDC,AAVE-USDC,GHST-USDC,QUICK-USDC
SECONDARY_MAX_POSITION_USD=100
MAX_OPPORTUNITY_AGE_MS=100000

# ============================================
# Optimizer
# ============================================
OPTIMIZER_SAMPLES=4
WORKER_POOL_SIZE=3
LP_MAX_PAIRS_PER_CYCLE=5

# ============================================
# Subgraph (for Classic Incentive)
# ============================================
SUBGRAPH_API_KEY=

# ============================================
# Classic Incentive
# ============================================
CLASSIC_INCENTIVE_POSITION_SIZE_USD=5000

# ============================================
# Harvest (if enabled)
# ============================================
HARVEST_FLASHLOAN_AMOUNT_USD=5000
HARVEST_MAX_POOL_DEPTH_PCT=1.5
HARVEST_FLASHLOAN_PROTOCOL=morpho-markets-v1