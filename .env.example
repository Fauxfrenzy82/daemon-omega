# ============================================
# CORE CONFIGURATION (REQUIRED)
# ============================================
RPC_URL=https://polygon-rpc.com
RPC_WS_URL=wss://polygon-ws.com
CHAIN_ID=137
EXECUTION_PRIVATE_KEY=0x...
TREASURY_ADDRESS=0x...
ENSO_API_KEY=your_enso_api_key
DATABASE_URL=postgresql://...

# ============================================
# SUBGRAPH (For QuickSwap Discovery)
# ============================================
SUBGRAPH_API_KEY=your_subgraph_api_key

# ============================================
# CLASSIC INCENTIVE - OPTIONAL PROTOCOL ADDRESSES
# ============================================
# Priority 1: Beefy Finance Vaults
BEEFY_VAULT_ADDRESS=0x...
BEEFY_WETH_VAULT=0x...

# Priority 2: Convex / Harvest Finance
CONVEX_ADDRESS=0x...
HARVEST_VAULT_ADDRESS=0x...

# QuickSwap Farm (optional override)
QUICKSWAP_FARM_ADDRESS=0x...

# ============================================
# POSITION-BASED PROTOCOLS (SKIPPED - Reference Only)
# ============================================
BALANCER_GAUGE_ADDRESS=0x...
CURVE_GAUGE_ADDRESS=0x...
MERKL_ADDRESS=0x...
MORPHO_ADDRESS=0x...

# ============================================
# CLASSIC INCENTIVE CONFIG
# ============================================
CLASSIC_INCENTIVE_MIN_PROFIT_USD=0.05
CLASSIC_INCENTIVE_MAX_PROTOCOLS=20
CLASSIC_INCENTIVE_POSITION_SIZE_USD=5000

# ============================================
# RISK / THRESHOLDS
# ============================================
DEFAULT_MIN_PROFIT_USD=0.05
DEFAULT_MIN_SPREAD_BPS=2
MAX_POSITION_SIZE_USD=25000
MAX_CONCURRENT_TRADES=3
MAX_SLIPPAGE_BPS=300
MAX_PRICE_IMPACT_BPS=300
MAX_GAS_PRICE_GWEI=300

# ============================================
# CIRCUIT BREAKER
# ============================================
MAX_CONSECUTIVE_LOSSES=999
CIRCUIT_BREAKER_LOOKBACK_MINUTES=5
CIRCUIT_BREAKER_COOLDOWN_MS=900000

# ============================================
# SWEEP (Profit Collection)
# ============================================
SWEEP_ENABLED=true
SWEEP_MIN_BALANCE_USD=2
SWEEP_KEEP_GAS_RESERVE_USD=1
SWEEP_TARGET_SYMBOL=USDC
SWEEP_DUST_THRESHOLD_USD=0.01

# ============================================
# ALERTS (Discord - Optional)
# ============================================
DISCORD_WEBHOOK_URL=

# ============================================
# SCANNER
# ============================================
SCAN_INTERVAL_MS=15000
LOG_LEVEL=info
NODE_ENV=production

# ============================================
# MASTER STRATEGY TOGGLE
# ============================================
MASTER_STRATEGY_ENABLED=true

# ============================================
# STRATEGY TOGGLES
# ============================================
STRATEGY_CLASSIC_ENABLED=true
STRATEGY_LP_ENABLED=false
STRATEGY_VAULT_ENABLED=false
STRATEGY_DEBT_ENABLED=false
STRATEGY_HARVEST_ENABLED=false

# ============================================
# OPTIMIZER / WORKERS
# ============================================
OPTIMIZER_SAMPLES=4
WORKER_POOL_SIZE=3
LP_MAX_PAIRS_PER_CYCLE=5

# ============================================
# ENSO
# ============================================
USE_ENSO_ROUTE_PRIMARY=true
ENSO_REQUEST_DELAY_MS=800

# ============================================
# PAIRS
# ============================================
PRIMARY_PAIR_IDS=WETH-USDC,WBTC-USDC,WMATIC-USDC,USDCe-USDT,DAI-USDC
SECONDARY_PAIR_IDS=LINK-USDC,AAVE-USDC,GHST-USDC,QUICK-USDC
SECONDARY_MAX_POSITION_USD=100
MAX_OPPORTUNITY_AGE_MS=100000

# ============================================
# HARVEST (if enabled)
# ============================================
HARVEST_FLASHLOAN_AMOUNT_USD=5000
HARVEST_MAX_POOL_DEPTH_PCT=1.5
HARVEST_FLASHLOAN_PROTOCOL=morpho-markets-v1